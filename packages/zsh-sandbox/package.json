{
  "name": "@yorkew-east8/dsh-zsh-sandbox",
  "description": "Sandbox-consuming zsh executor for the DeepSeek Harness (dsh) shell seam — subclasses the shipped bash executor and overrides only its confine() hook to run zsh -c",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yorkew-east8/dsh-tool-zsh.git",
    "directory": "packages/zsh-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-bash-local": "*",
    "@deepseek-ai/dsh-bash-sandbox": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-shell": "*"
  }
}
