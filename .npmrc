# The @deepseek-ai/* packages are provided by the dsh runtime (parent-walk
# resolution from $DSH_HOME/profiles/node_modules), never by npm.
#
# Every @deepseek-ai/* entry in these packages is a peerDependency with the
# range "*" on purpose. Peer auto-install would make pnpm try to fetch them
# from the public registry -- where a stale 0.0.1-rc.1 exists -- and would
# silently install a version that does not match the running dsh.
auto-install-peers=false
strict-peer-dependencies=false
